<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%
    String currentURI = request.getRequestURI();
    boolean isLoginPage = currentURI.contains("login.jsp");
    boolean isRegisterPage = currentURI.contains("register.jsp");
    boolean isCartPage = currentURI.contains("cart.jsp") || currentURI.endsWith("/cart");
    boolean isCheckoutPage = currentURI.contains("checkout.jsp") || currentURI.endsWith("/checkout");
    boolean hideNavElements = isLoginPage || isRegisterPage;
    boolean hideCartIcon = hideNavElements || isCartPage || isCheckoutPage;

    Object utente = session.getAttribute("utente");
    if (utente == null) {
        utente = session.getAttribute("user");
    }
%>
<header>
    <div class="left">
        <a href="${pageContext.request.contextPath}/home" class="logo">
            <img src="${pageContext.request.contextPath}/img/logo.svg" alt="VibeShop Icon" class="brand-icon"/>
        </a>
        <span class="brand-text">VibeShop</span>
    </div>

    <% if (!hideNavElements) { %>
    <nav class="navbar">
        <form method="get" action="${pageContext.request.contextPath}/search" class="search-form">
            <div class="search-container">
                <input type="text" name="ricerca" placeholder="Cerca..." required />
                <button type="submit" class="search-btn" aria-label="Cerca">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                </button>
            </div>
        </form>
    </nav>
    <% } %>

    <div class="header-actions">
        <div class="right">
            <% if (utente != null) { %>
                <a href="${pageContext.request.contextPath}/profile" class="login"><%= utente %></a>
            <% } else if (isLoginPage) { %>
                <a href="${pageContext.request.contextPath}/jsp/register.jsp" class="login">Registrati</a>
            <% } else if (isRegisterPage) { %>
                <a href="${pageContext.request.contextPath}/jsp/login.jsp" class="login">Accedi</a>
            <% } else { %>
                <a href="${pageContext.request.contextPath}/jsp/login.jsp" class="login">Login</a>
            <% } %>

            <% if (!hideCartIcon) { %>
            <a href="${pageContext.request.contextPath}/cart" class="cart-link">
                <img src="${pageContext.request.contextPath}/img/shop.svg" alt="Carrello" class="cart-icon"/>
                <span class="cart-count"><%
                    Object cc = session.getAttribute("cartCount");
                    out.print(cc != null ? cc : 0);
                %></span>
            </a>
            <% } %>
        </div>

        <button id="menu-btn" class="menu-trigger" aria-label="Menu">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="3" y1="10" x2="21" y2="10"></line>
                <line x1="12" y1="16" x2="21" y2="16"></line>
            </svg>
        </button>
    </div>
</header>
