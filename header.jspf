<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%
    // Recuperiamo l'URI della pagina per capire dove si trova l'utente
    String currentURI = request.getRequestURI();
    
    // Controlliamo se siamo nella pagina di login o di registrazione
    boolean isLoginPage = currentURI.contains("login.jsp");
    boolean isRegisterPage = currentURI.contains("register.jsp");
%>
<header>
    <div class="left">
        <a href="${pageContext.request.contextPath}/homepage.jsp" class="logo">
            <img src="${pageContext.request.contextPath}/img/logo.svg" alt="VibeShop Icon" class="brand-icon"/>
        </a>
        <span class="brand-text">VibeShop</span>
    </div>

    <%-- La barra di ricerca viene mostrata SOLO se NON siamo in login o register --%>
    <% if (!isLoginPage && !isRegisterPage) { %>
    <nav class="navbar">
        <form method="get" action="${pageContext.request.contextPath}/Ricerca" class="search-form">
            <div class="search-container">
                <input type="text" name="ricerca" placeholder="Cerca..." required />
                <button type="submit" class="search-btn" aria-label="Cerca">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                </button>
            </div>
        </form>
    </nav>
    <% } %>

    <div class="header-actions">
        <div class="right">
            <% if (isLoginPage) { %>
                <%-- Se l'utente è in login, mostriamo il link per registrarsi --%>
                <a href="${pageContext.request.contextPath}/jsp/register.jsp" class="login">Registrati</a>
            <% } else if (isRegisterPage) { %>
                <%-- Se l'utente è in registrazione, mostriamo il link per accedere --%>
                <a href="${pageContext.request.contextPath}/jsp/login.jsp" class="login">Accedi</a>
            <% } else { %>
                <%-- In tutte le altre pagine (es. Homepage) mostra i link standard --%>
                <a href="${pageContext.request.contextPath}/jsp/login.jsp" class="login">Login</a>
                <a href="${pageContext.request.contextPath}/jsp/cart.jsp" class="cart-link">
                    <img src="${pageContext.request.contextPath}/img/shop.svg" alt="Carrello" class="cart-icon" />
                    <span class="cart-count">0</span>
                </a>
            <% } %>
        </div>

        <%-- Il bottone del menu a tendina (hamburger/icona) si vede SOLO fuori da login/register --%>
        <% if (!isLoginPage && !isRegisterPage) { %>
        <button id="menu-btn" class="menu-trigger" aria-label="Menu">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="3" y1="10" x2="21" y2="10"></line>
                <line x1="12" y1="16" x2="21" y2="16"></line>
            </svg>
        </button>
        <% } %>
    </div>

    <%-- Anche la lista dei link del menu a tendina viene generata solo nelle altre pagine --%>
    <% if (!isLoginPage && !isRegisterPage) { %>
    <nav id="nav-menu" class="nav-left">
        <a href="#">Concerti</a>
        <a href="#">Artisti</a>
        <a href="#">Merch</a>
    </nav>
    <% } %>
</header>
